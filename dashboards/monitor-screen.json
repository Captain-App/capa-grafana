{
  "dashboard": {
    "id": null,
    "uid": "monitor-screen",
    "title": "Monitor Screen",
    "tags": ["monitoring", "dashboard"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "type": "timeseries",
        "title": "CPU Usage",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "100 - (avg by (cpu) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "refId": "A",
            "legendFormat": "CPU Usage %"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "opacity",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "axisPlacement": "auto",
              "axisLabel": "Percentage",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 70,
                  "color": "yellow"
                },
                {
                  "value": 90,
                  "color": "red"
                }
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          },
          "overrides": []
        }
      },
      {
        "id": 2,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "type": "timeseries",
        "title": "Error Counts",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "sum(rate(pg_stat_database_deadlocks_total[5m]))",
            "refId": "A",
            "legendFormat": "Database Deadlocks/sec"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "sum(rate(pg_stat_database_conflicts_total[5m]))",
            "refId": "B",
            "legendFormat": "Database Conflicts/sec"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "sum(rate(http_status_codes_total{code=~\"5..\"}[5m]))",
            "refId": "C",
            "legendFormat": "HTTP 5xx Errors/sec"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "sum(rate(supabase_usage_metrics_user_queries_total[5m]))",
            "refId": "D",
            "legendFormat": "User Queries/sec"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "opacity",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "axisPlacement": "auto",
              "axisLabel": "Errors/sec",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 10,
                  "color": "red"
                }
              ]
            },
            "unit": "ops"
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "type": "stat",
        "title": "Current CPU Usage",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "sum(rate(supabase_usage_metrics_user_queries_total[5m]))",
            "refId": "A",
            "legendFormat": "Queries/sec"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 70,
                  "color": "yellow"
                },
                {
                  "value": 90,
                  "color": "red"
                }
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          },
          "overrides": []
        }
      },
      {
        "id": 4,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "type": "stat",
        "title": "Total Error Count (1h)",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "sum(increase(pg_stat_database_deadlocks_total[1h]))",
            "refId": "A",
            "legendFormat": "Deadlocks (1h)"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "sum(increase(http_status_codes_total{code=~\"5..\"}[1h]))",
            "refId": "B",
            "legendFormat": "HTTP 5xx Errors (1h)"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "supabase-metrics"
            },
            "expr": "sum(increase(pg_stat_database_conflicts_total[1h]))",
            "refId": "C",
            "legendFormat": "Conflicts (1h)"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 10,
                  "color": "yellow"
                },
                {
                  "value": 100,
                  "color": "red"
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "links": [],
    "liveNow": false,
    "weekStart": ""
  },
  "overwrite": true,
  "message": "Deployed via GitHub Actions"
}

